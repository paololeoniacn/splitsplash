{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitsplash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitsplash",
      // Replace with the id printed by `npx wrangler d1 create splitsplash`
      "database_id": "38df91fa-c158-4c66-8d56-a23449c10f30",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "JOIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Per /48 (IPv6) or /24 (IPv4): stops rotating through addresses in one allocation
      "name": "NETWORK_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Ceiling across all clients (per Cloudflare location) on passphrase guessing
      "name": "GLOBAL_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // Writes per room (or keyring): one member can't burn the database's daily write quota for everyone
      "name": "WRITE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
